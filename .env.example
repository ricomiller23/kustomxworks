# ─────────────────────────────────────────────────────────────────────────────
# KustomXworks Environment Variables
# Copy this to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (via Resend) ────────────────────────────────────────────────────────
# Required for the lead form to send email notifications.
# Get your key at: https://resend.com
# If this is not set, leads are logged to the server console instead (no user impact).
RESEND_API_KEY=

# The email address where new leads will be delivered.
NOTIFICATION_EMAIL=you@kustomxworks.com

# ── CRM / Webhook (optional) ──────────────────────────────────────────────────
# Uncomment and set if you want to push leads to a CRM or automation tool.
# TODO: connect CRM/email — see app/api/lead/route.ts for the TODO marker.
# CRM_WEBHOOK_URL=https://hooks.zapier.com/...

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used for canonical URLs and OG metadata in production.
NEXT_PUBLIC_SITE_URL=https://www.kustomxworks.com

# ── Google Analytics (optional) ───────────────────────────────────────────────
# Uncomment and set to activate GA4. See the placeholder in app/layout.tsx.
# GA4 / GTM placeholder — add your measurement ID here
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
